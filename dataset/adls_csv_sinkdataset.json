{
	"name": "adls_csv_sinkdataset",
	"properties": {
		"linkedServiceName": {
			"referenceName": "ADLSLinkedService",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"target_container": {
				"type": "string"
			},
			"target_folder": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"folderPath": {
					"value": "@dataset().target_folder",
					"type": "Expression"
				},
				"fileSystem": {
					"value": "@dataset().target_container",
					"type": "Expression"
				}
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": []
	}
}
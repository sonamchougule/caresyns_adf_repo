{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-caresync23"
		},
		"ADLSLinkedService_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adfcaresyncstorage.dfs.core.windows.net/"
		},
		"AzureKeyVault1_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://key-caresync23.vault.azure.net/"
		},
		"AzureSqlDatabase1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "caresync-server23.database.windows.net"
		},
		"AzureSqlDatabase1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "caresync-db"
		},
		"AzureSqlDatabase1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sonamchougule"
		},
		"PostgreSqllinkedservice_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-purple-cake-b2mom7ig-pooler.c-6.eu-central-1.aws.neon.tech"
		},
		"PostgreSqllinkedservice_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"PostgreSqllinkedservice_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"datarbricksLinkedservice_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1001-104201-aursw6bl"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-caresync23_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ADLSLinkedService_properties_typeProperties_url": {
						"value": "[parameters('ADLSLinkedService_properties_typeProperties_url')]"
					},
					"AzureKeyVault1_properties_typeProperties_baseUrl": {
						"value": "[parameters('AzureKeyVault1_properties_typeProperties_baseUrl')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_server')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_database')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_userName": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_userName')]"
					},
					"PostgreSqllinkedservice_properties_typeProperties_server": {
						"value": "[parameters('PostgreSqllinkedservice_properties_typeProperties_server')]"
					},
					"PostgreSqllinkedservice_properties_typeProperties_database": {
						"value": "[parameters('PostgreSqllinkedservice_properties_typeProperties_database')]"
					},
					"PostgreSqllinkedservice_properties_typeProperties_username": {
						"value": "[parameters('PostgreSqllinkedservice_properties_typeProperties_username')]"
					},
					"datarbricksLinkedservice_properties_typeProperties_existingClusterId": {
						"value": "[parameters('datarbricksLinkedservice_properties_typeProperties_existingClusterId')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}
{
	"name": "P_Source_Silver",
	"properties": {
		"activities": [
			{
				"name": "Read_Tables_for_Ingestion",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select * from ctrl.table_config where is_active=1 and source_system='@{pipeline().parameters.Source_system}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "SQLDBdataset",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "IterateThroughEachtable",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Read_Tables_for_Ingestion",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Read_Tables_for_Ingestion').output.value",
						"type": "Expression"
					}
				}
			},
			{
				"name": "CurrentDateTime",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Current Date Time",
					"value": {
						"value": "@formatDateTime(utcNow(),'yyyy-MM-ddThh:mm:ss')",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"Source_system": {
				"type": "string"
			}
		},
		"variables": {
			"Current Date Time": {
				"type": "String"
			}
		},
		"annotations": []
	}
}